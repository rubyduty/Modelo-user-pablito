                                    "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
                                    "pm.test(\"Devuelve el usuario creado\", function () { pm.expect(pm.response.json().data.email).to.eql(\"pepe@example.com\"); });",
                                    "pm.test(\"No devuelve la contraseña\", function () { pm.expect(pm.response.json().data).to.not.have.property(\"password\"); });"
